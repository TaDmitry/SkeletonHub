{
	"compilerOptions": {
		"target": "ESNext",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "node",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "preserve",
		"incremental": true,
		"plugins": [
			{
				"name": "next"
			}
		],
		"baseUrl": "src",
		"paths": {
			"@/*": ["*"],
			"@shared/*": ["shared/*"],
			"@styles/*": ["shared/styles/*"],
			"@ui": ["shared/ui"],
			"@components": ["shared/components"],
			"@features/*": ["features/*"],
			"@widgets/*": ["widgets/*"],
			"@entities/*": ["entities/*"],
			"@routes/*": ["app/routes/*"]
		}
	},
	"include": ["next-env.d.ts", "src", ".next/types/**/*.ts", "next.config.ts"],
	"exclude": ["node_modules", ".next"]
}
