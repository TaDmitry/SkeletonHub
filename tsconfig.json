{
	"compilerOptions": {
		"target": "ESNext",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "preserve",
		"incremental": true,
		"plugins": [
			{
				"name": "next"
			}
		],
		"baseUrl": "src",
		"paths": {
			"@/*": ["*"],
			"@shared/*": ["shared/*"],
			"@styles/*": ["shared/styles/*"],
			"@ui/*": ["shared/ui/*"],
			"@features/*": ["features/*"],
			"@widgets/*": ["widgets/*"],
			"@entities/*": ["entities/*"],
			"@routes/*": ["app/routes/*"]
		}
	},
	"include": [
		"next-env.d.ts",
		"src/**/*.ts",
		"src/**/*.tsx",
		".next/types/**/*.ts",
		"*.config.ts",
		"src/**/*"
	],
	"exclude": ["node_modules"]
}
