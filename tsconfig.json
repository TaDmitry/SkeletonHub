{
	"compilerOptions": {
		"target": "ESNext",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"incremental": true,
		"plugins": [
			{
				"name": "next"
			}
		],
		"baseUrl": "src",
		"paths": {
			"@/*": ["*"],
			"@shared/*": ["shared/*"],
			"@components/*": ["shared/components/*"],
			"@config/*": ["shared/config/*"],
			"@constants/*": ["shared/constants/*"],
			"@messages/*": ["shared/messages/*"],
			"@styles/*": ["shared/styles/*"],
			"@ui/*": ["shared/ui/*"],
			"@features/*": ["features/*"],
			"@widgets/*": ["widgets/*"],
			"@entities/*": ["entities/*"]
		}
	},
	"include": [
		"next-env.d.ts",
		"src",
		".next/types/**/*.ts",
		"next.config.ts",
		".next/dev/types/**/*.ts",
		"commitlint.config.cjs",
		"eslint.config.mjs",
		"postcss.config.js",
		"stylelint.config.mjs"
	],
	"exclude": ["node_modules", ".next"]
}
