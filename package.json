{
	"name": "my-ui",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"prepare": "husky install",
		"dev": "next dev --turbo",
		"build": "next build",
		"start": "next start",
		"prettier:check": "prettier --check .",
		"prettier:write": "prettier --write .",
		"lint": "eslint --ext .js,.jsx,.ts,.tsx .",
		"lint:fix": "eslint --ext .js,.jsx,.ts,.tsx --fix .",
		"lint:strict": "eslint --ext .js,.jsx,.ts,.tsx --fix --max-warnings=0 .",
		"lint:css": "stylelint \"**/*.{css,scss,sass,module.scss,module.sass}\"",
		"lint:css:fix": "stylelint \"**/*.{css,scss,sass,module.scss,module.sass}\" --fix",
		"format:all": "prettier --write . && npm run lint:fix && npm run lint:css:fix",
		"ci:lint": "npm run prettier:check && npm run lint && npm run lint:css"
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"next": "^15.5.6",
		"react": "^19.1.0",
		"react-dom": "^19.1.0"
	},
	"devDependencies": {
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"@eslint/eslintrc": "^3.3.1",
		"@types/eslint-plugin-jsx-a11y": "^6.10.0",
		"@types/eslint-plugin-security": "^3.0.0",
		"@types/node": "^22.16.3",
		"@types/react": "^19.2.2",
		"@types/react-dom": "^19.2.2",
		"@typescript-eslint/parser": "^8.38.0",
		"eslint": "^9.31.0",
		"eslint-config-next": "15.4.1",
		"eslint-config-prettier": "^10.1.5",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-prettier": "^5.5.1",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-simple-import-sort": "^12.1.1",
		"eslint-plugin-unicorn": "^62.0.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.1.2",
		"postcss-pxtorem": "^6.1.0",
		"postcss-scss": "^4.0.9",
		"prettier": "^3.6.2",
		"sass": "^1.89.2",
		"stylelint": "^16.24.0",
		"stylelint-config-prettier-scss": "^1.0.0",
		"stylelint-config-recommended-scss": "^16.0.2",
		"stylelint-config-standard": "^39.0.0",
		"stylelint-scss": "^6.12.1",
		"typescript": "^5.8.3"
	}
}
