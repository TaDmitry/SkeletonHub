{
	"name": "skeleton-hub",
	"version": "0.2.0",
	"private": true,
	"scripts": {
		"prepare": "husky install",
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"prettier:check": "prettier --check .",
		"prettier:write": "prettier --write .",
		"lint": "eslint .",
		"lint:fix": "eslint --fix .",
		"lint:strict": "eslint --fix --max-warnings=0 .",
		"format:all": "prettier --write . && npm run lint:fix",
		"stylelint": "stylelint \"src/**/*.{scss,css}\"",
		"stylelint:fix": "stylelint \"src/**/*.{scss,css}\" --fix",
		"ci:lint": "npm run prettier:check && npm run lint && npm run stylelint"
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"date-fns": "^4.1.0",
		"next": "^16.1.6",
		"next-intl": "^4.8.2",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"zustand": "^5.0.11"
	},
	"devDependencies": {
		"@commitlint/cli": "^20.4.1",
		"@commitlint/config-conventional": "^20.4.1",
		"@svgr/webpack": "^8.1.0",
		"@types/node": "^24.10.13",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@typescript-eslint/eslint-plugin": "^8.50.0",
		"@typescript-eslint/parser": "^8.50.0",
		"baseline-browser-mapping": "^2.9.19",
		"eslint": "^9.39.2",
		"eslint-config-next": "16.1.6",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-prettier": "^5.5.5",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.0.1",
		"eslint-plugin-simple-import-sort": "^12.1.1",
		"eslint-plugin-sonarjs": "^3.0.7",
		"eslint-plugin-unicorn": "^63.0.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"postcss-pxtorem": "^6.1.0",
		"postcss-scss": "^4.0.9",
		"prettier": "^3.8.1",
		"sass": "^1.97.3",
		"stylelint": "^17.3.0",
		"stylelint-config-clean-order": "^8.0.1",
		"stylelint-config-css-modules": "^4.6.0",
		"stylelint-config-standard-scss": "^17.0.0",
		"stylelint-order": "^7.0.1",
		"svgo": "^4.0.0",
		"typescript": "^5.9.3"
	}
}
